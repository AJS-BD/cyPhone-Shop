{
  "name": "cyPhone Shop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "forwardPorts": [
    3000,
    8081,
    19000
  ],
  "portsAttributes": {
    "3000": {
      "label": "App",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Metro",
      "onAutoForward": "notify"
    },
    "19000": {
      "label": "Expo",
      "onAutoForward": "notify"
    }
  }
}
